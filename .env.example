# Generate with: openssl rand -hex 32
ADMIN_KEY=replace-with-a-long-random-admin-key
BITCOIN_RPC_URL=http://host.docker.internal:8332
BITCOIN_RPC_USER=monitor
BITCOIN_RPC_PASSWORD=replace-with-your-bitcoin-rpc-password

# Optional prebuilt image. Use `docker compose pull` and `up -d --no-build`.
# NODARIUM_IMAGE=ghcr.io/primexz/nodarium:master

# SQLite is the default. Its file is kept in the monitor-data Docker volume.
DB_DRIVER=sqlite
DB_DSN=

# To use an existing PostgreSQL database instead, set both:
# DB_DRIVER=postgres
# DB_DSN=postgres://monitor:URL_ENCODED_PASSWORD@database-host:5432/nodarium?sslmode=verify-full

POLL_INTERVAL=10s
# Structured JSON logs: debug, info, warn, or error. Restart after changing.
LOG_LEVEL=info
COOKIE_SECURE=false
PORT=8080
# Set your server's private LAN IP to allow LAN/VPN access.
BIND_ADDRESS=127.0.0.1

# Public IPv4/IPv6 of your Bitcoin node, used to locate it on the peer map.
# Leave empty to try Core's advertised addresses. LAN/private IPs cannot be geolocated.
NODE_IP=
NODE_LOCATION_NAME="My node"
# By default a free DB-IP City Lite database is downloaded and cached in /data/geoip.
# Optional: mount your own city MMDB file and set its container path here.
# GEOIP_DB_PATH=/data/geoip/custom-city.mmdb
# Custom paths disable automatic downloads unless explicitly enabled.
# GEOIP_AUTO_DOWNLOAD=false
